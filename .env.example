# ==============================================================================
# Cross Inventory (Flota La Macarena) - Variables de Entorno de Producción
# ==============================================================================

# Entorno: development | production
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://inventario.flotalamacarena.com

# ------------------------------------------------------------------------------
# 🐘 Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=inventario-postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=tu_password_segura_de_produccion
DB_NAME=inventario
DB_LOGGING=false

# ------------------------------------------------------------------------------
# 🔐 Autenticación Keycloak (SSO)
# ------------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=https://sso.flotalamacarena.com
KEYCLOAK_REALM=Inventory-realm
KEYCLOAK_CLIENT_ID=inventory-backend
SESSION_SECRET=generar_un_string_aleatorio_largo_de_64_caracteres

# ------------------------------------------------------------------------------
# 📦 Almacenamiento de Archivos S3-Compatible (MinIO / AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
FILE_STORAGE_ENDPOINT=http://minio:9000
FILE_STORAGE_ACCESS_KEY=usuario_minio_prod
FILE_STORAGE_SECRET_KEY=password_minio_prod
FILE_STORAGE_BUCKET=inventario-docs
FILE_STORAGE_PUBLIC_URL=https://archivos.flotalamacarena.com/inventario-docs

# ------------------------------------------------------------------------------
# 📡 Mensajería y Notificaciones de Correo
# Proveedor: api (API REST Interna) | smtp (Servidor SMTP) | console (Desarrollo)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=api
MAIL_API_URL=http://10.10.20.123:8016/send-mail
MAIL_CONCEPTO=Inventario - Traslado de Activos
MAIL_DEFAULT_CC=auditoria.sistemas@flotalamacarena.com
MAIL_DEFAULT_BCC=control.interno@flotalamacarena.com

# ------------------------------------------------------------------------------
# 📱 Notificaciones WhatsApp (Wasapi API)
# ------------------------------------------------------------------------------
# Token API generado en la consola de Wasapi (Obligatorio para envíos reales)
WASAPI_API_KEY=tu_token_bearer_de_wasapi_aqui
# Endpoint de mensajería (Opcional, por defecto usa https://api-ws.wasapi.io/api/v1/whatsapp-messages)
WASAPI_URL=https://api-ws.wasapi.io/api/v1/whatsapp-messages
# ID numérico de la línea telefónica emisora en Wasapi (Opcional si solo tienes una línea)
WASAPI_FROM_ID=

# Permitir bypass de certificados SSL en redes con firewall/proxy de inspección (true | false)
ALLOW_INSECURE_TLS=false

